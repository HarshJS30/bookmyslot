generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  bookings      Booking[]
  events        Event[]   @relation("OrganizerEvents")
  sessions      Session[]
}

model Event {
  id               String           @id @default(cuid())
  name             String
  startsAt         DateTime
  organizerId      String
  venueId          String
  organizer        User             @relation("OrganizerEvents", fields: [organizerId], references: [id])
  venue            Venue            @relation(fields: [venueId], references: [id])
  seats            Seat[]
  ticketCategories TicketCategory[]
}

model TicketCategory {
  id      String  @id @default(cuid())
  name    String
  price   Decimal
  eventId String
  seats   Seat[]  @relation("CategorySeats")
  event   Event   @relation(fields: [eventId], references: [id])

  @@unique([id, eventId])
}

model Venue {
  id       String  @id @default(cuid())
  name     String
  location String
  events   Event[]
}

model Seat {
  id           String         @id @default(cuid())
  eventId      String
  seatLabel    String
  status       SeatStatus     @default(AVAILABLE)
  reservedAt   DateTime?
  categoryId   String
  bookingSeats BookingSeat[]
  category     TicketCategory @relation("CategorySeats", fields: [categoryId, eventId], references: [id, eventId])
  event        Event          @relation(fields: [eventId], references: [id])

  @@unique([eventId, seatLabel])
}

model Booking {
  id           String        @id @default(cuid())
  userId       String
  createdAt    DateTime      @default(now())
  status       BookingStatus @default(PENDING)
  user         User          @relation(fields: [userId], references: [id])
  bookingSeats BookingSeat[]
  payment      Payment?
}

model BookingSeat {
  bookingId String
  seatId    String
  booking   Booking @relation(fields: [bookingId], references: [id])
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@id([bookingId, seatId])
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ORGANIZER
  USER
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
